<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="AddB2a7LYh4WD0zDgPtIDG" LanguageVersion="2024.6.7-0009-ga0a8422da0" Version="0.128">
  <NugetDependency Id="C0QK3vrGj0405tDNrRiVf8" Location="VL.CoreLib" Version="2025.7.0" />
  <NugetDependency Id="LASv5nggvtzDxMKutU4Bb8" Location="VL.Skia" Version="2025.7.0" />
  <Patch Id="Osfn6ICDyds3JiPlU8gQBN">
    <Canvas Id="P0pMLQtiTwwwUzVQUeX4pU" DefaultCategory="Main" CanvasType="FullCategory" />
    <Node Name="Application" Bounds="100,100" Id="SM17bB8CiLBJVwJXsJcRih">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <FullNameCategoryReference ID="Primitive" />
      </p:NodeReference>
      <Patch Id="F5LRA9NQmNKWnmZdwfc4pF">
        <Canvas Id="LWmhhSuE3wlpGCVo4oHF40" CanvasType="Group">

          <Pad Id="RJRZ8JRCPkVrES7hqIit7C" Bounds="60,30,600,150" ShowValueBox="true" isIOBox="true" Value="VL.Mapsui spike. One question: does a Mapsui map reach the screen inside vvvv?&#xD;&#xA;&#xD;&#xA;LEFT window is the probe, and it draws nothing but what it measured. Read it before looking at the map. An orange 200x120 box at pixel (40,40) plus a few lines of text means pixel-space handling works, and anything still wrong after that is Mapsui's. No box at all means the layer never rendered. A box of the wrong size means the matrix is wrong.&#xD;&#xA;&#xD;&#xA;Change the Space dropdown and the box must NOT move. That is the point: the layer resets the canvas matrix itself instead of trusting a pin whose wrong value is silently replaced by the default.&#xD;&#xA;&#xD;&#xA;RIGHT window is the map. Tiles arrive over the network, so give it a moment.&#xD;&#xA;&#xD;&#xA;Do not launch vvvv with VL.GIS loaded: it uses BruTile 6 and Mapsui.Tiling needs BruTile 5.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>

          <!--
            Probe first. This layer takes no inputs at all, so if it draws nothing the fault is
            upstream of anything we could have got wrong about Mapsui.
          -->
          <Node Bounds="60,220,140,19" Id="PUMIIeohRkgDSWH4ZVG3Sp">
            <p:NodeReference LastCategoryFullName="Mapsui.Map" LastDependency="VL.Mapsui.csproj">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="DiagnosticsLayer" />
            </p:NodeReference>
            <Pin Id="LEH6epwg1RYjoIRglHZSFE" Name="Result" Kind="OutputPin" />
          </Node>

          <Pad Id="DOm1TZ5XHvhwOiG1ypH6Ly" Comment="Space" Bounds="240,220,110,19" ShowValueBox="true" isIOBox="true" Value="Normalized">
            <p:TypeAnnotation LastCategoryFullName="VL.Skia" LastDependency="VL.Skia.dll">
              <Choice Kind="TypeFlag" Name="CommonSpace" />
            </p:TypeAnnotation>
          </Pad>

          <!--
            ClientBounds reports in the current space's own units, so it is the only direct
            answer to "which space is actually in effect". Worth reading here because VL.Skia's
            Sizing docs say one unit is 100 pixels, which VL.GIS's notes currently contradict.
          -->
          <Pad Id="BKJ4hc9TyiFpQ7LcUmkQPi" Comment="ClientBounds" Bounds="380,220,200,44" ShowValueBox="true" isIOBox="true" />

          <Pad Id="UCsTxBqx59l8zOEGGBDZl2" Comment="Background" Bounds="60,270,143,20" ShowValueBox="true" isIOBox="true" Value="0.1, 0.1, 0.15, 1">
            <p:TypeAnnotation LastCategoryFullName="Color" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="RGBA" />
            </p:TypeAnnotation>
          </Pad>

          <Node Bounds="60,320,165,19" Id="G2Dvlp79v4drHdYj1GTZs9">
            <p:NodeReference LastCategoryFullName="Graphics.Skia" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Renderer" />
            </p:NodeReference>
            <Pin Id="J6ADLJAUPGCtoeCbuaVnjl" Name="Bounds" Kind="InputPin" DefaultValue="80, 120, 640, 520">
              <p:TypeAnnotation LastCategoryFullName="System.Drawing" LastDependency="System.Drawing.dll">
                <Choice Kind="TypeFlag" Name="Rectangle" />
              </p:TypeAnnotation>
            </Pin>
            <Pin Id="PXew3OfSGdylG0UrEPH1p1" Name="Bound to Document" Kind="InputPin" DefaultValue="True">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="Boolean" />
              </p:TypeAnnotation>
            </Pin>
            <Pin Id="O3B9VE0RklH6FlzpuuTlQg" Name="Input" Kind="InputPin" />
            <Pin Id="LHev7DD3kYwBN9tOtn5p3l" Name="Color" Kind="InputPin" />
            <Pin Id="GPuvKZtetiSycHd8PVw0Sj" Name="Clear" Kind="InputPin" />
            <Pin Id="LwR6FFhXHTHiRZ9mNH5IhD" Name="Space" Kind="InputPin" />
            <Pin Id="LMIumRUscEsARY7WB6n2Xc" Name="Show Cursor" Kind="InputPin" />
            <Pin Id="TvFd2tOhL7hvQ45zOVDF8L" Name="VSync" Kind="InputPin" />
            <Pin Id="OiiwjPHYAxifB2q7GXC0zS" Name="Enabled" Kind="InputPin" />
            <Pin Id="Fbeq052vSZGmW5R04dxfLc" Name="Form" Kind="OutputPin" />
            <Pin Id="RSWti3SSqL9uKBmNX5edZy" Name="ClientBounds" Kind="OutputPin" />
            <Pin Id="L89cLvTefYAnebrXsDMMQ8" Name="Render Time" Kind="OutputPin" />
          </Node>

          <!-- The map itself, in its own window so the probe stays readable. -->
          <Pad Id="LMRff9SFVBan4J6vjs7dAS" Comment="Longitude" Bounds="700,220,62,15" ShowValueBox="true" isIOBox="true" Value="139.7">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="Lr2Jbr3v8L0W2nPdijyN4h" Comment="Latitude" Bounds="780,220,62,15" ShowValueBox="true" isIOBox="true" Value="35.68">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="AGPhKEy645b7yl85VyV7Zf" Comment="Zoom Level" Bounds="860,220,50,15" ShowValueBox="true" isIOBox="true" Value="12">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Integer32" />
            </p:TypeAnnotation>
          </Pad>

          <Node Bounds="700,270,175,19" Id="TFk2QX4tI1CqAusuRRq8gB">
            <p:NodeReference LastCategoryFullName="Mapsui.Map" LastDependency="VL.Mapsui.csproj">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="CreateOpenStreetMap" />
            </p:NodeReference>
            <Pin Id="PaGyprb8NHKyXGg0qD4Ojj" Name="Center Longitude" Kind="InputPin" />
            <Pin Id="UsRgGO8hTOCDMYaxyqYsEf" Name="Center Latitude" Kind="InputPin" />
            <Pin Id="LnpkBOpFJlmElbd7rfNIax" Name="Zoom Level" Kind="InputPin" />
            <Pin Id="CQhlYKvaJhLlFvXDqs2H4t" Name="Result" Kind="OutputPin" />
          </Node>

          <Node Bounds="700,310,120,19" Id="BK48WIR8OJwGSGQpYFQ7RC">
            <p:NodeReference LastCategoryFullName="Mapsui.Map" LastDependency="VL.Mapsui.csproj">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="ToSkiaLayer" />
            </p:NodeReference>
            <Pin Id="U660mUbEyYf0Cmi3O0Vc3n" Name="Map" Kind="InputPin" />
            <Pin Id="EVAYn9i1WpIxX444WJomva" Name="Result" Kind="OutputPin" />
          </Node>

          <Node Bounds="700,360,165,19" Id="KSjWOaFNxDW66cHa6AQpDx">
            <p:NodeReference LastCategoryFullName="Graphics.Skia" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Renderer" />
            </p:NodeReference>
            <Pin Id="LgQKBaxI16ZajWqmvOjhCE" Name="Bounds" Kind="InputPin" DefaultValue="760, 120, 640, 520">
              <p:TypeAnnotation LastCategoryFullName="System.Drawing" LastDependency="System.Drawing.dll">
                <Choice Kind="TypeFlag" Name="Rectangle" />
              </p:TypeAnnotation>
            </Pin>
            <Pin Id="RBVC84ASUpQSe5G6HxIHYl" Name="Bound to Document" Kind="InputPin" DefaultValue="True">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="Boolean" />
              </p:TypeAnnotation>
            </Pin>
            <Pin Id="SSVIqHAqV6dszWFKbVERd0" Name="Input" Kind="InputPin" />
            <Pin Id="FquPa3meLqCHzTezyLfD9B" Name="Color" Kind="InputPin" />
            <Pin Id="BkPEaFXAMmc9aR2kPSONzz" Name="Clear" Kind="InputPin" />
            <Pin Id="SUtvRMGgPahYQwtJyTk4rT" Name="Space" Kind="InputPin" />
            <Pin Id="FaaoTtLNugGzx7SRkcfquE" Name="Show Cursor" Kind="InputPin" />
            <Pin Id="L1oU3GLTslNic6t9V3v5ig" Name="VSync" Kind="InputPin" />
            <Pin Id="IRo6ZEsH078iOrqGtqGQKD" Name="Enabled" Kind="InputPin" />
            <Pin Id="D3hYUDPei6LAwlbAlcjJUP" Name="Form" Kind="OutputPin" />
            <Pin Id="UV7GBs4S39SkxseSCFC55j" Name="ClientBounds" Kind="OutputPin" />
            <Pin Id="PQgHrdZqlbxXU1WEcADVzs" Name="Render Time" Kind="OutputPin" />
          </Node>

        </Canvas>
        <Patch Id="Fa6wlmznkFvZKJsD8lhThL" Name="Create" />
        <Patch Id="V4s4buAHJQ9BDTOzg2NaO7" Name="Update" />
        <ProcessDefinition Id="LppCHgt9eab1tA6kCpFMZh">
          <Fragment Id="MGINlHfyCgND6o4FqeXTtF" Patch="Fa6wlmznkFvZKJsD8lhThL" Enabled="true" />
          <Fragment Id="Il7TDUwY8LmbDGk201IUvk" Patch="V4s4buAHJQ9BDTOzg2NaO7" Enabled="true" />
        </ProcessDefinition>
        <Link Id="BAcCfNtDZ0tsUcLwAydoDy" Ids="LEH6epwg1RYjoIRglHZSFE,O3B9VE0RklH6FlzpuuTlQg" />
        <Link Id="SzNAieKZzzMEfjiXmnT2FI" Ids="DOm1TZ5XHvhwOiG1ypH6Ly,LwR6FFhXHTHiRZ9mNH5IhD" />
        <Link Id="PjqRovt55rkdnzgR03ZtJG" Ids="UCsTxBqx59l8zOEGGBDZl2,LHev7DD3kYwBN9tOtn5p3l" />
        <Link Id="LjRrtMfF5Ut4rt2wektQ68" Ids="RSWti3SSqL9uKBmNX5edZy,BKJ4hc9TyiFpQ7LcUmkQPi" />
        <Link Id="EzMTY5Sn9yLVfOo8lf0Y3t" Ids="LMRff9SFVBan4J6vjs7dAS,PaGyprb8NHKyXGg0qD4Ojj" />
        <Link Id="O4gcaOUWqiBurYzraSMOAc" Ids="Lr2Jbr3v8L0W2nPdijyN4h,UsRgGO8hTOCDMYaxyqYsEf" />
        <Link Id="ORmqmge6TCZArczEXLxupF" Ids="AGPhKEy645b7yl85VyV7Zf,LnpkBOpFJlmElbd7rfNIax" />
        <Link Id="Mb64NFTwG6Ky2KUMkKcNzr" Ids="CQhlYKvaJhLlFvXDqs2H4t,U660mUbEyYf0Cmi3O0Vc3n" />
        <Link Id="GqHb8NgceY9AVrKgODQUCx" Ids="EVAYn9i1WpIxX444WJomva,SSVIqHAqV6dszWFKbVERd0" />
      </Patch>
    </Node>
  </Patch>

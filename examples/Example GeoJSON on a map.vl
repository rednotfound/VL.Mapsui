            <Pin Id="T8FlHZCGgcBI0InyFmfool" Name="Layer" Kind="InputPin" />
            <Pin Id="NFHGqRAp95Ibg5stwUPuv2" Name="Trigger" Kind="InputPin" />
            <Pin Id="VzHH0x8bPl6DDD7xQ0GWM5" Name="Margin" Kind="InputPin" />
            <Pin Id="UMcwMKzEE7Q6aJK6u5yUzN" Name="Result" Kind="OutputPin" />
          </Node>

            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="BnsroGbfGpePuClcSCsdqe" Bounds="640,388,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Drag pans while Dragging is true and remembers the previous frame for you. Left Pressed is the choice made here.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">

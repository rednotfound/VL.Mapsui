          </Pad>
          <Pad Id="GTGpJhFKgUZcPzNhtbjB87" Bounds="640,300,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Wheel State accumulates. FrameDifference turns it into the change per frame, which is what ZoomByWheel wants. Mapsui reads only its sign.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>

          <Pad Id="C03OGKNZORCSrSfQX7cl2u" Bounds="640,190,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; MouseState is fed from Console, which is grouped with the map layer into the Renderer: this mouse belongs to this window.">

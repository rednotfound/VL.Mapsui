          </Pad>
          <Pad Id="T92t3CdHRtMaEkwWQ2e2Xb" Bounds="940,300,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Add builds the attribute table: Key &quot;Name&quot;, Value the text. Chain Adds for more columns.">

          </Pad>
          <Pad Id="TPgMtag2WEOG2M8re3wvUf" Bounds="940,440,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; The style underneath still draws the shape. LabelStyle wraps it rather than replacing it.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>

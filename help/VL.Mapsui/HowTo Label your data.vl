<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="VLHxnsZzcEC6MBNW1IZZxG" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="SIMDywDLwNbQ5UdOPHQxYD" Location="VL.CoreLib" Version="2025.7.4" />
  <NugetDependency Id="Sm17wEPgUJCVB75op3gzPF" Location="VL.Skia" Version="2025.7.4" />
  <NugetDependency Id="CCoTJSCcdlnfZwmjUnPFVB" Location="VL.Mapsui" Version="0.0.0" />
  <!--
    NetTopologySuite is declared HERE, by this document, and that is not the same as VL.Mapsui
    declaring it. VL.Mapsui's own declaration is what lets its node signatures name NTS types; a
    patch that wants to use NTS nodes itself needs its own dependency on it. Measured: without this
    line the node below is "Not found"; with it, it resolves.
  -->
  <NugetDependency Id="KkbVvAgR3UtmSGnGV4pAoR" Location="NetTopologySuite" Version="2.6.0" />
  <!--
    VL.NetTopologySuite is the package that MAKES geometry; this one draws it. VL.Mapsui's nuspec
    depends on it so that opening this patch does not greet you with red nodes - vvvv does not
    fetch a missing document dependency by itself, it shows it red and offers to install on
    rightclick.
  -->
  <NugetDependency Id="QVnZMbPyNO4lv6YFocyiqT" Location="VL.NetTopologySuite" Version="0.0.1-alpha" />
  <Patch Id="FJzZkKqVfW12i9kQk6L0hz">
    <Canvas Id="N0E8bKG5vqG1aLaGsfcogC" DefaultCategory="Main" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="Pt4eKK7Ag0dikcitT4Vmar">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <FullNameCategoryReference ID="Primitive" />
      </p:NodeReference>
      <Patch Id="T1yChjTcVpcQLJ4rxMEL44">
        <Canvas Id="VxYLn5bECvkjhyGerEE3sc" CanvasType="Group">
          <Pad Id="VaZNqihOnpwz6dORWEdpu0" Bounds="60,30,620,180" ShowValueBox="true" isIOBox="true" Value="Labelling your data - letting the map write the words for you.&#xD;&#xA;&#xD;&#xA;A LABEL IS NOT TEXT YOU PLACE. LabelStyle's Attribute pin names an ATTRIBUTE, and every feature that carries one gets its own word, in its own place, at its own zoom. Two features here, one style, two different labels - and adding a third feature adds a third label with nothing else to change. That is why it is worth learning: the alternative, one text node per label, stops working the moment the data has a hundred rows.&#xD;&#xA;&#xD;&#xA;THIS IS WHAT THE OTHER HALF OF A FEATURE IS FOR. A Feature is geometry PLUS attributes, and the attributes have been empty in every other patch here. Dictionary Add builds one: leave its Input UNCONNECTED and you start from an empty dictionary, because that is the type's default. Chain a second Add onto the first for a second attribute.&#xD;&#xA;&#xD;&#xA;The key is the contract between the two halves. &quot;name&quot; is written in the attribute, &quot;name&quot; is written on LabelStyle, and they have to match - change one and the labels go blank. Nothing warns you, so change both.&#xD;&#xA;&#xD;&#xA;Try: type into the value IOBoxes - the labels change as you type, and Layers Built stays at 1, because a feature's contents are replaced rather than its layer rebuilt. Empty LabelStyle's Attribute pin - the labels vanish and the fill stays, since a style with nothing named has nothing to write. Change Label Size - the text grows while the shapes do not, because a label is drawn in pixels and geometry in metres.&#xD;&#xA;&#xD;&#xA;STYLE TAKES A STYLE. LabelStyle's Style pin holds the VectorStyle, and the two arrive at the layer as one thing - a layer takes a single style, so combining is how you get both. The order in the chain is the order they draw in: fill first, then the word on top of it.&#xD;&#xA;&#xD;&#xA;The shapes come from VL.NetTopologySuite, as everywhere else here: this package draws geometry, it does not create it. Read WKT is one source of it and a file reader would be another.&#xD;&#xA;&#xD;&#xA;Enabled starts OFF on the tile layer. Opening a document in vvvv runs it, so a map that fetched on open would give you no chance to decline.&#xD;&#xA;&#xD;&#xA;Watch Layers Built: it should settle at 1 and stay. A number climbing frame after frame means something rebuilds the layer every frame, and every rebuild starts a fresh round of tile requests. Close vvvv if you see it climb.&#xD;&#xA;&#xD;&#xA;Where to go next: HowTo Draw your own shapes for the chain without labels, HowTo Stack several layers for layer order and ZoomToLayer, HowTo Add widgets to the map for the scale bar and the attribution the tile policy asks for.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="UnaIkq8cPr0a4UZQVn7ji7" Comment="Enabled" Bounds="79,280,35,35" ShowValueBox="true" isIOBox="true" Value="false">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="ImmutableTypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CNYLiTg3BUtmCJlFwHyUjv" Comment="Cache To Disk" Bounds="207,280,35,35" ShowValueBox="true" isIOBox="true" Value="true">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="ImmutableTypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="79,340,150,19" Id="JqwwJBWIvaSJq4DTAz8vuN">
            <p:NodeReference LastCategoryFullName="Mapsui.Layers" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="OpenStreetMap" />
            </p:NodeReference>
            <Pin Id="Usi9xynIVqJWvRhEvGVOYQ" Name="Enabled" Kind="InputPin" />
            <Pin Id="ARy89W2GJw4s60rzwfmBsV" Name="Cache" Kind="InputPin" />
            <Pin Id="VE109xy4WqBycyAwxMeCrD" Name="Result" Kind="OutputPin" />
            <Pin Id="MVGJGduk0mPWJznoGv9YVX" Name="Layers Built" Kind="OutputPin" />
            <Pin Id="HwRnfleRlGfpKEI7pXlafv" Name="Cache Status" Kind="OutputPin" />
          </Node>
          <Pad Id="RgIIgaq8NiTBppqeaxZgPe" Comment="Layers Built" Bounds="153,391,80,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="87,523,39,19" Id="IuHPlniMpFcdUZg9WNt7Xp">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Cons" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="FitnqKKJuItGI6PwD5m2Mp" Name="Input" Kind="InputPin" />
            <Pin Id="Udad8igNKGlXkj4SIfvVV8" Name="Input 2" Kind="InputPin" />
            <Pin Id="Obo0KlAOX8uJTLEhkSgG4Y" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="QTNlTyezfmbasb8gEcPG61" Comment="Initial Longitude" Bounds="140,583,62,15" ShowValueBox="true" isIOBox="true" Value="135.7581">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="I8MAlGEJKxag8SUuQTLx71" Comment="Initial Latitude" Bounds="229,544,62,15" ShowValueBox="true" isIOBox="true" Value="34.9859">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="MU5GcscWwFrk45xrCPm07u" Comment="Initial Zoom Level" Bounds="329,583,50,15" ShowValueBox="true" isIOBox="true" Value="15">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Integer32" />
            </p:TypeAnnotation>
          </Pad>
          <!--
            ***** your own shapes, from here down *****

            The shape has to come from somewhere, and that somewhere is NOT VL.Mapsui: this package
            draws geometry, it does not create it. In a real patch the geometry comes from VL.GIS,
            from a file, or from a service. Here it is a fixture so the example stands on its own.

            Read WKT is one way in and the shortest one to read on a page. VL.NetTopologySuite also
            builds geometry coordinate by coordinate - Coordinate, LinearRing, Polygon - and its own
            HowTo Create a polygon shows that. Either way what arrives here is the same type, which
            is the point: geometry is a TYPE, not a format.
          -->
          <Pad Id="IrotR4gFylcZ62ydUXjBUC" Comment="WKT - the station" Bounds="300,430,420,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((135.7565 34.9848, 135.7597 34.9848, 135.7597 34.9870, 135.7565 34.9870, 135.7565 34.9848))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>

          <Node Bounds="300,470,90,19" Id="F5vfpYSEn6YZY4v3D0jivA">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="Kb4sXPGCYJ0jU6Zyvu99Tv" Name="WKT" Kind="InputPin" />
            <Pin Id="UtvFvoNAEkKql434eX5gs6" Name="Factory" Kind="InputPin" />
            <Pin Id="E0X52rFVPedYg2yFKnLn8M" Name="Result" Kind="OutputPin" />
            <Pin Id="OgXXHEYRAmZYPBiQSUUGoM" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="RS6Hqm6oVzhIG8hIyXH2eJ" Comment="parsed?" Bounds="420,470,60,15" ShowValueBox="true" isIOBox="true" />

          <!--
            ***** what makes a label possible *****

            A Feature is geometry PLUS attributes, and this is the attributes half finally being
            used. Dictionary Add builds one entry: leave its Input unconnected and you start from an
            empty dictionary, which is what the type's default is.

            The key is what LabelStyle will look up. Change "name" to something else in both places
            and the map labels itself with that instead.
          -->
          <Pad Id="HGP1rmsjVxPDxnOTru8beX" Comment="key" Bounds="620,470,110,15" ShowValueBox="true" isIOBox="true" Value="name">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="LGtwJci1BGc0aQ6Vd7RgiK" Comment="value" Bounds="620,495,110,15" ShowValueBox="true" isIOBox="true" Value="Kyoto Station">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="620,520,53,26" Id="RWIfEsRqDpp3Rlackc7ZjC">
            <p:NodeReference LastCategoryFullName="Collections.Dictionary" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Add" />
              <CategoryReference Kind="RecordType" Name="Dictionary" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="MZ7L8rlVq8PgUM4iexhZzS" Name="Input" Kind="StateInputPin" />
            <Pin Id="A2MwBQcBrOEBq5qt2zSLmS" Name="Key" Kind="InputPin" />
            <Pin Id="PQmavk7r4bugSLYvWQ29Ch" Name="Value" Kind="InputPin" />
            <Pin Id="Px8c9IZ8rmzrxsLDzpiJBe" Name="Output" Kind="StateOutputPin" />
          </Node>

          <Node Bounds="300,510,110,19" Id="LKlHCGkEW27uDksjQ03tsc">
            <p:NodeReference LastCategoryFullName="Mapsui" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Feature" />
            </p:NodeReference>
            <Pin Id="VZkOsrOFuCUESnjJOlfiv8" Name="Geometry" Kind="InputPin" />
            <Pin Id="T4DyhbpJF7z3MVEDGgU1l4" Name="Attributes" Kind="InputPin" />
            <Pin Id="T3xaP10ssIBu1W84JenuLS" Name="Result" Kind="OutputPin" />
          </Node>

          <!--
            ***** a second feature on the SAME layer *****

            One layer, two features, one style - and two different labels, because LabelColumn names
            an attribute rather than carrying the text. That is the whole point of it.
          -->
          <Pad Id="L3sCYKzDqfJ1Ln07iscIZJ" Comment="WKT - the temple" Bounds="760,430,420,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((135.7470 34.9800, 135.7502 34.9800, 135.7502 34.9822, 135.7470 34.9822, 135.7470 34.9800))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="760,470,90,19" Id="Mvw0wWq7iYh07qtlWO9SOS">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="VC6eiuumEU9ZF15v0tCeBi" Name="WKT" Kind="InputPin" />
            <Pin Id="KQcx3XRZOrrtlXSlXLN7di" Name="Factory" Kind="InputPin" />
            <Pin Id="PbQtP61o3GOyrsTd5H7060" Name="Result" Kind="OutputPin" />
            <Pin Id="QCKEsIDkpLyLbuB4i2Aedh" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="SPoGHPkhHTTJMpNpdvn5vM" Comment="key" Bounds="1000,470,110,15" ShowValueBox="true" isIOBox="true" Value="name">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="ELTkm3wJi1QIrMhJjqHMPH" Comment="value" Bounds="1000,495,110,15" ShowValueBox="true" isIOBox="true" Value="Toji Temple">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="1000,520,53,26" Id="IlAfU7YYtPaBvzMkbB19JD">
            <p:NodeReference LastCategoryFullName="Collections.Dictionary" LastDependency="VL.Collections.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Add" />
              <CategoryReference Kind="RecordType" Name="Dictionary" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="Js6Ftw4EWi7LsyjVQtgem5" Name="Input" Kind="StateInputPin" />
            <Pin Id="HFhtow0YTfDoYcgKG1nenI" Name="Key" Kind="InputPin" />
            <Pin Id="VDTknQYGfwMggmvCG14oBT" Name="Value" Kind="InputPin" />
            <Pin Id="JhiUpC16QLwmysryQygVUO" Name="Output" Kind="StateOutputPin" />
          </Node>
          <Node Bounds="760,560,110,19" Id="HcC4GmxTQkOX0h9f1QBHMp">
            <p:NodeReference LastCategoryFullName="Mapsui" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Feature" />
            </p:NodeReference>
            <Pin Id="PNKrWr4KJbpUT0gsGW7XhA" Name="Geometry" Kind="InputPin" />
            <Pin Id="Tz1zq6vR6pQ7JbgqkEZRcD" Name="Attributes" Kind="InputPin" />
            <Pin Id="RrfmPdrt92ItSEVnLBtEmd" Name="Result" Kind="OutputPin" />
          </Node>

          <!--
            ***** the labels *****

            Attribute names an ATTRIBUTE, not the text: one style, and every feature gets its own
            word. Style takes the VectorStyle so both arrive at the layer as one thing, because a
            layer takes a single style. Empty the Attribute pin and the fill passes through
            untouched - nothing named, nothing to write.
          -->
          <Pad Id="RZzJ7ARmOHcsPdJWcCLoP3" Comment="Label Attribute" Bounds="760,640,110,15" ShowValueBox="true" isIOBox="true" Value="name">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="LKQjuhfaOhae1zpNGMpoU2" Comment="Label Size" Bounds="880,640,62,15" ShowValueBox="true" isIOBox="true" Value="16">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float32" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="520,590,130,19" Id="T23qWAurpyrgoRh8fLKCdS">
            <p:NodeReference LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="LabelStyle" />
            </p:NodeReference>
            <Pin Id="QNGu1JxjXlXVk8x5Vzah2L" Name="Style" Kind="InputPin" />
            <Pin Id="ULIbppmgrRmENEkrSodKrP" Name="Attribute" Kind="InputPin" />
            <Pin Id="MdXpohRLjhyLuWsCdwFoHx" Name="Color" Kind="InputPin" />
            <Pin Id="D4vCbMFhMY5ij6p7V7EUj9" Name="Size" Kind="InputPin" />
            <Pin Id="AzHYShl1Cy0Pdw52S7C5ZT" Name="Result" Kind="OutputPin" />
          </Node>

          <Node Bounds="300,550,39,19" Id="A4jSu2sjauZP2s8LlxSayy">
            <p:NodeReference LastCategoryFullName="Collections.Spread" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Cons" />
              <CategoryReference Kind="RecordType" Name="Spread" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="Hv9nORTiBeD0FjRJwQP1zt" Name="Input" Kind="InputPin" />
            <Pin Id="LVp2NShI38PM2uwngTMRoZ" Name="Input 2" Kind="InputPin" />
            <Pin Id="PAwh0bTqOnKYu3GBgYxASP" Name="Result" Kind="OutputPin" />
          </Node>

          <!--
            The style is a value of its own, and a node rather than pins on the layer. Leave it
            unconnected and the layer still draws something visible - good defaults are part of the
            public API.
          -->
          <Node Bounds="520,510,130,19" Id="T4PA3iOraHVrJGn6DvQeiR">
            <p:NodeReference LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="VectorStyle" />
            </p:NodeReference>
            <Pin Id="NWFqDIKalaxaGQVLqfQHBi" Name="Fill Color" Kind="InputPin" />
            <Pin Id="F00RpgC9bhD9HuhOAUsoNX" Name="Line Color" Kind="InputPin" />
            <Pin Id="UumeV5rj8Ly2LZmKZzyjuo" Name="Line Width" Kind="InputPin" />
            <Pin Id="VMyWIw2DDLYJnnMn4lhUAv" Name="Result" Kind="OutputPin" />
          </Node>

          <Node Bounds="300,590,150,19" Id="RYg4JjkLhluvFy6irExfYD">
            <p:NodeReference LastCategoryFullName="Mapsui.Layers" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="FeatureLayer" />
            </p:NodeReference>
            <Pin Id="AMeaHKeDjwSfsDqswpSIBi" Name="Features" Kind="InputPin" />
            <Pin Id="Sb8LY47ypOqKRxpyRAwgiA" Name="Style" Kind="InputPin" />
            <Pin Id="U7vVs30TfyVg6lNRtRKCvd" Name="Name" Kind="InputPin" />
            <Pin Id="UX2Q4zuDSJ3FicIQjybU4g" Name="Layers Built" Kind="OutputPin" />
            <Pin Id="Ck0b9Fm6W6GxEbNGJgeI05" Name="Result" Kind="OutputPin" />
          </Node>

          <Node Bounds="87,643,110,19" Id="Uap6qMPmqPyqpm6OmKwWZU">
            <p:NodeReference LastCategoryFullName="Mapsui.Maps" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Map" />
            </p:NodeReference>
            <Pin Id="H1dkptL5CUJAlSE1SJXIiL" Name="Layers" Kind="InputPin" />
            <Pin Id="Dc7rTes8gEFct080wrJNsg" Name="Initial Center Longitude" Kind="InputPin" />
            <Pin Id="LpWIQOKhRMT4Jt3tKQLG58" Name="Initial Center Latitude" Kind="InputPin" />
            <Pin Id="JXjk0f1EzodWnmeV9gOzZp" Name="Initial Zoom Level" Kind="InputPin" />
            <Pin Id="SHAzWUqXFUmNiPpi2L0l9h" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="-207,850,110,19" Id="BtM6e71LrPauAI1Lu5QMUn">
            <p:NodeReference LastCategoryFullName="Mapsui" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="ViewportInfo" />
            </p:NodeReference>
            <Pin Id="TIjKhLd4rTZDn2dSnszv01" Name="Map" Kind="InputPin" />
            <Pin Id="RkfLJEI1nD6Jqo2WEFBeYS" Name="Center Longitude" Kind="OutputPin" />
            <Pin Id="UUT74iRejEUw8kpEAa6dHx" Name="Center Latitude" Kind="OutputPin" />
            <Pin Id="NHrVzYogipFEDxC3IV2qWZ" Name="Resolution" Kind="OutputPin" />
            <Pin Id="NIsTrVwZSBOI2ZxVDBGylo" Name="Width" Kind="OutputPin" />
            <Pin Id="Ai21lXxwGlrZ63Z4TigeFN" Name="Height" Kind="OutputPin" />
          </Node>
          <Pad Id="FFjk3xX3QUXJDZcekXlKZa" Comment="Actual Longitude" Bounds="-205,898,90,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="IhsKJMIfZsfYF6xUlVucLc" Comment="Actual Latitude" Bounds="-205,927,90,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="C3LbWfwVElJKvc3TxkWobj" Comment="m per pixel" Bounds="-205,958,90,15" ShowValueBox="true" isIOBox="true" />
          <!--
            ***** enough mouse to see the point *****

            Drag and ZoomByWheel are gestures, not per-frame commands: they move the map only when
            you actually drag or scroll, so the view stays yours. That is what lets this patch show
            the one thing it is about - the shape staying on its ground while the map moves under
            it. The wiring is copied from HowTo Drive the map with the mouse, which is where the
            reasoning behind each link lives.
          -->
          <Node Bounds="480,700,90,19" Id="FCFHOaQxJF6hICTzgc0kV2">
            <p:NodeReference LastCategoryFullName="Graphics.Skia" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Console" />
            </p:NodeReference>
            <Pin Id="EkFs6mHHZIMujfdgEOqlk2" Name="Output" Kind="OutputPin" />
            <Pin Id="RO8aBSYCJdhlqHJCEIyLAA" Name="Mouse" Kind="OutputPin" />
            <Pin Id="MwdWPjIgy6Udsm4trupS2X" Name="Keyboard" Kind="OutputPin" />
            <Pin Id="BXefzE2nNAcdukZNFHUU3Y" Name="Notifications" Kind="OutputPin" />
          </Node>
          <Node Bounds="480,740,185,19" Id="SNTO2Jhhli4U4wWW3wUbhZ">
            <p:NodeReference LastCategoryFullName="IO.Mouse" LastSymbolSource="CoreLibBasics.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="MouseState" />

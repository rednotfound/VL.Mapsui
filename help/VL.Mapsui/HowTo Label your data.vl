            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="TKKOg3NMtWDhpxqcVmxhAY" Bounds="940,510,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Attribute names the column to write; Color and Size are the text. The halo is on by default, and a label over a point lifts itself clear of the marker.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EbgxaRfkONLGVpuVkmbDFR" Bounds="940,598,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; A feature without the attribute gets no label and no error. Status counts what is drawn.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="PKktUdQXfflOser4bgunJ8" Bounds="940,668,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Labels do not rise above later layers - a layer above covers them. When it matters, put a label-only layer last.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>

            </Pin>
            <Pin Id="SrPmAAWGAIpzM6WiGpBd73" Name="Initial Zoom Level" Kind="InputPin" DefaultValue="2">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="Integer32" />
              </p:TypeAnnotation>
            </Pin>
          </Node>
          <Node Bounds="60,230,130,19" Id="VEQuyV6NmbZxYwqjCTTJHA">
            <p:NodeReference LastCategoryFullName="Mapsui.Skia" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="ToSkiaLayer" />
            </p:NodeReference>
            <Pin Id="EGgF3hdFBDentHDHhlIbqf" Name="Map" Kind="InputPin" />
            <Pin Id="EOibNt44FGeExjKljHWYlU" Name="Diagnostics" Kind="InputPin" />
            <Pin Id="PDW0gMO0o6lHCEbDVtCljw" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,290,185,19" Id="IgIzBCI2UwlWII0CPZfqbO">
            <p:NodeReference LastCategoryFullName="Graphics.Skia" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Renderer" />
            </p:NodeReference>
            <Pin Id="TOACb64XpEaXB2fzTniwrr" Name="Bounds" Kind="InputPin" DefaultValue="926, 114, 900, 560">
              <p:TypeAnnotation LastCategoryFullName="System.Drawing" LastDependency="System.Drawing.dll">
                <Choice Kind="TypeFlag" Name="Rectangle" />
              </p:TypeAnnotation>
            </Pin>
            <Pin Id="MRxe3yXw8hgpdnuj0OoZwy" Name="Bound to Document" Kind="InputPin" DefaultValue="True">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="Boolean" />
              </p:TypeAnnotation>
            </Pin>
            <Pin Id="PpuALE0feor4m2RJdlm7ne" Name="Input" Kind="InputPin" />
          </Node>
          <Pad Id="LQP8hVxCkXWHYRx3V1Bv0O" Bounds="300,170,300,60" ShowValueBox="true" isIOBox="true" Value="no tile layer, no network - the graticule alone gives the window its bearings. The Initial pins put the view over Japan at world scale; zoom the spacing instead of the map and watch the grid stay a grid.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="PMnokcYxWQORzRZeyauG3g" Comment="Show Labels" Bounds="140,20,55,28" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="ImmutableTypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
        <Patch Id="GBeXBTznYV7k5yLxAjbkPT" Name="Create" />
        <Patch Id="PNszjp45z4tf3NBem3B4a3" Name="Update" />

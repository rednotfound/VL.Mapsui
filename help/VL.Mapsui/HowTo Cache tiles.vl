            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="LL1DzB1k9ap96PoWjjsxO5" Bounds="640,366,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Reads the disk, never the network: Tiles and Size MB are true with the layer switched off. Delete the folder to start over.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>

          <Pad Id="DSoq5GDNdbNHHO1ieJvHV3" Bounds="879,174,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Enabled defaults ON: a cache touches nobody's network, and keeping drawn tiles is what OSM's policy asks for. Off means every restart refetches the same view.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="LmQKdC76lZdS5x8b8Re199" Bounds="879,267,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Folder unconnected = %LOCALAPPDATA%\VL.Mapsui\tiles. To move it, connect a Path IOBox with an ABSOLUTE path, never an empty one: VL reads &quot;&quot; as this document's folder.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>

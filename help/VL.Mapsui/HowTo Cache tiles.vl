            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="LmQKdC76lZdS5x8b8Re199" Bounds="640,278,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Folder unconnected = %LOCALAPPDATA%\VL.Mapsui\tiles. To move it, connect a Path IOBox with an ABSOLUTE path, never an empty one: VL reads &quot;&quot; as this document's folder.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>

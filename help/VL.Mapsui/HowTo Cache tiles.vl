          <Pad Id="DSoq5GDNdbNHHO1ieJvHV3" Bounds="640,190,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Enabled defaults ON: a cache touches nobody's network, and keeping drawn tiles is what OSM's policy asks for. Off means every restart refetches the same view.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>

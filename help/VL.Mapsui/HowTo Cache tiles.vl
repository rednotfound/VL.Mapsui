            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="LL1DzB1k9ap96PoWjjsxO5" Bounds="879,363,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Reads the disk, never the network: Tiles and Size MB are true with the layer switched off. Delete the folder to start over.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="T1G4lEBdP5jAi8zG9ohfsg" Bounds="879,444,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Switch the layer on: Tiles rises by exactly what was drawn, and nothing is fetched ahead. That is the policy.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">

            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="IBSciNasmGhH9NMr59RkLy" Bounds="879,560,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Cache Status is where THIS layer writes. An unusable or relative folder is reported here, not replaced by the default.">

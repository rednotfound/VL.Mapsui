          </Pad>
          <Pad Id="T1G4lEBdP5jAi8zG9ohfsg" Bounds="640,436,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Switch the layer on: Tiles rises by exactly what was drawn, and nothing is fetched ahead. That is the policy.">
            <p:TypeAnnotation>

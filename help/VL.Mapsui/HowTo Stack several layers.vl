            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CxYRngb7EMfgQ3IJy5KkGS" Bounds="940,400,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Switch a layer off: it draws nothing and costs nothing, and keeps what it holds - a tile layer keeps its tiles. Taking it out of the Cons throws that away.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>

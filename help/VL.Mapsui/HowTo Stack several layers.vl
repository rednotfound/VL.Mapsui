          <!--
            ZoomToLayer answers "put the view where the data is". It is triggered rather than
            continuous: framing on every frame would pin the view and the map could not be dragged
            at all - the same reason ZoomIn watches an edge. An empty layer moves nothing, so a bang
            landing before the data does no harm.
          -->
          <Pad Id="FrAAoKuMOh5K0ye1ORqZKd" Comment="Frame the line" Bounds="300,700,35,35" ShowValueBox="true" isIOBox="true" Value="false">

            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FYfq8mXf1nFdfMynYHktG2" Bounds="940,510,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Order is spread order: index 0 is the bottom, the graticule here. Swap the two feature links and the small square vanishes under the big one. There is no z-index.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">

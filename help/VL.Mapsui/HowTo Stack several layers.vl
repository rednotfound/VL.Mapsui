          <Pad Id="BDsr1b4MzRwJpqKXMSJrQ3" Bounds="940,190,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Two squares over Kyoto. The small red one is wired LAST into the Cons, so it draws on top of the big blue one.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="KQTftzLo005z5m17YTjdcU" Bounds="940,330,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; One style per layer. A layer treats a new style object as a change and rebuilds, so the style nodes hand out a stable one.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>

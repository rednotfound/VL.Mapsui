          <Pad Id="TzdkxJVUFVY1pkvhh1OZGg" Bounds="640,251,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Attribution is what the Attribution widget shows for this layer. Nearly every service requires it; an empty pin credits nobody.">

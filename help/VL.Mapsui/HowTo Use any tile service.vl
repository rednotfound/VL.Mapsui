          <Pad Id="Kez3yYOL1JG2oGUZ2VW0wF" Bounds="640,325,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Enabled starts OFF. Every service has a usage policy - read it before you switch on. OpenTopoMap is CC-BY-SA and asks for this credit.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">

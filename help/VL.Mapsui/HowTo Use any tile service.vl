            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="TS4ikwMuyONyu3dFOgKa3i" Bounds="640,491,320,42" ShowValueBox="true" isIOBox="true" Value="&lt; Layers Built counts rebuilds: a new URL or a flip of Enabled is one each. It must never climb on its own.">

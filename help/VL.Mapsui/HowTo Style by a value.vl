<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="M6QSEbPXKyxnifPdyJg2XE" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="FvbQ4kBzcCaf85TS9Z1A9P" Location="VL.CoreLib" Version="2025.7.4" />
  <NugetDependency Id="NcGF1uAnzxPxy5du79EPEv" Location="VL.Skia" Version="2025.7.4" />
  <NugetDependency Id="EhXUtqhGQHwPdi2sC878UY" Location="VL.Mapsui" Version="0.0.0" />
  <!--
    NetTopologySuite is declared HERE, by this document, and that is not the same as VL.Mapsui
    declaring it. A patch that wants to use NTS nodes itself needs its own dependency on it.
  -->
  <NugetDependency Id="T8QyBgYxMVXrPOIT136oHA" Location="NetTopologySuite" Version="2.6.0" />
  <NugetDependency Id="KMuauNt2NqAyVGfE2FnfN9" Location="VL.NetTopologySuite" Version="0.0.1-alpha" />
  <Patch Id="Vbp1A8a3LkhSUVNiW40DJw">
    <Canvas Id="JBAytg4ZSsdzN63bF51peh" DefaultCategory="Main" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="STYdPBmfZt4pyjmv5f9REL">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <FullNameCategoryReference ID="Primitive" />
      </p:NodeReference>
      <Patch Id="P9pVWzx6KsAZVOdiwrFktE">
        <Canvas Id="ObsXF7JJo1KwfrQCRBU8hr" CanvasType="Group">
          <Pad Id="P8NhOo03OsxNuor0ykYG95" Bounds="-780,-80,640,1300" ShowValueBox="true" isIOBox="true" Value="Styling by a value - what a choropleth is made of.&#xD;&#xA;&#xD;&#xA;Five squares. Four carry a number ('value': 0, 33, 66, 100) and the map paints each with the&#xD;&#xA;blend its number earns: StyleByValue maps the range [Min, Max] onto the range between two&#xD;&#xA;styles. Light at 0, dark at 100, every value in between gets its share. Desktop GIS calls this&#xD;&#xA;graduated colours, and it is StyleByGeometry's sibling: that one picks a style by what a&#xD;&#xA;feature IS, this one by what a feature SAYS.&#xD;&#xA;&#xD;&#xA;THE FIFTH SQUARE IS NOT DRAWN, ON PURPOSE. It has no 'value' attribute, and a feature whose&#xD;&#xA;attribute is missing or not numeric earns nothing - not the Min style, nothing. Raw Mapsui&#xD;&#xA;would quietly read a missing attribute as 0 and dress the square in the Min style: a wrong&#xD;&#xA;answer wearing real clothes. Status counts what was refused and why, because the layer is the&#xD;&#xA;only place the features and the style meet.&#xD;&#xA;&#xD;&#xA;TRY:&#xD;&#xA;  Drag Max down to 33. The 66 and 100 squares clamp to the same full dark - values beyond the&#xD;&#xA;  range take the end styles rather than extrapolate.&#xD;&#xA;&#xD;&#xA;  Set Min and Max to the same number. Every readable square wears the Min style: a range of&#xD;&#xA;  one value means one style.&#xD;&#xA;&#xD;&#xA;  Retype Attribute to something wrong. Every square vanishes and Status says whose pin to&#xD;&#xA;  check.&#xD;&#xA;&#xD;&#xA;WHAT INTERPOLATES between two VectorStyles: fill colour, line colour, line width. Between two&#xD;&#xA;SymbolStyles: the scale - graduated circle sizes are the same node with different pins. Wire&#xD;&#xA;the SAME KIND into both style pins; a mix draws nothing and Status names it.&#xD;&#xA;&#xD;&#xA;Under the hood the interpolated styles are quantized to 64 steps - a resource decision, not a&#xD;&#xA;visual one. A style's identity is what the renderer keys its caches on, and a fresh style per&#xD;&#xA;feature per frame is a leak wearing a gradient. 64 steps is at most 4 of 255 per colour channel&#xD;&#xA;between neighbours, below anything an eye can resolve.&#xD;&#xA;&#xD;&#xA;NO BASEMAP IN THIS PATCH, and nothing to switch on: styling needs no network. The squares sit&#xD;&#xA;where Tokyo is, so an OpenStreetMap layer added into the layer Cons (first, so it lands&#xD;&#xA;underneath) puts real streets under the gradient - HowTo Show a map has the chain.&#xD;&#xA;&#xD;&#xA;Where to go next: HowTo Style mixed geometry for the by-kind sibling; HowTo Label your data to&#xD;&#xA;write each square's number on it; HowTo Draw your own shapes for where these features came&#xD;&#xA;from.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="VHqi2tJe2YZi0cTkDf1OGC" Comment="Attribute name" Bounds="560,-40,120,20" ShowValueBox="true" isIOBox="true" Value="value">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="NSDROiTWxI9Pm57Rzc2wZS" Bounds="-50,-40,500,15" ShowValueBox="true" isIOBox="true" Value="four squares that know their number, and one that does not:">

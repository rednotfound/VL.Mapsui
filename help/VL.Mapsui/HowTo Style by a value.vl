            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="AR1hevrN7yLJ7iSlrO6gZF" Bounds="780,635,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; The fifth square has no value: it is not drawn, and Status counts it. Raw Mapsui would read the missing attribute as 0 and dress it in the Min style.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>

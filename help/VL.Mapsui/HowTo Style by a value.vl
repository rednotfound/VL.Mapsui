          <Pad Id="MBfPySLddqofNhWpPAjWq0" Bounds="780,420,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Two VectorStyles are the ends of the ramp; everything between is interpolated - fill, outline and width. Between two SymbolStyles the scale interpolates instead.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>

            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CNJHIjHe7IMl69duCRa9S1" Bounds="780,723,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Retype Attribute to something wrong: every square vanishes and Status says whose pin to check.">

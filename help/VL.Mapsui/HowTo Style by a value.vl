            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="K0RZooaiqeMTAfCZaK5mvn" Bounds="780,540,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Attribute names the numeric column; Min and Max are the ends. Try Max 33: the 66 and 100 squares clamp to full dark rather than extrapolate.">
            <p:TypeAnnotation>

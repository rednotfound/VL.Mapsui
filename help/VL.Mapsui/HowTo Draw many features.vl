                <p:NodeReference LastCategoryFullName="Main.Landmark" LastDependency="HowTo Draw many features.vl">
                  <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
                  <CategoryReference Kind="RecordType" Name="Landmark" />
                  <Choice Kind="OperationCallFlag" Name="Create" />
                </p:NodeReference>
                <Pin Id="JkWuum19uzeoYOsIHUx0lQ" Name="Name" Kind="InputPin" />
                <Pin Id="RbMTocnzHVCmKwnWkOICPG" Name="Type" Kind="InputPin" />

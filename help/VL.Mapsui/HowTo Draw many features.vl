                <Pin Id="JhdMfjS8Ju8fDYHyv6uLb7" Name="Output" Kind="StateOutputPin" />
              </Node>
            </Patch>
          </Node>

          <!--
            ***** the Pad that separates building from drawing *****

            This glyph is a SLOT of the patch - storage that survives from one frame to the next.
            The Create fragment writes the spread into it once; Update only ever reads it. A Pad is
            the thing that connects the two halves, and there is no other way across.
          -->
          <Pad Id="TKlMWlp4NMGpF95VUsojMR" SlotId="HWyJRgqNRQNyYeiUzbABL8" Bounds="1180,700" />
          <Pad Id="KZ4GwssylmGNgVu7iyB3xu" Comment="Status" Bounds="1310,660,260,15" ShowValueBox="true" isIOBox="true" />

          <!--
            ToAttributes reads the record's property names. Name and Type up there become the keys
            "Name" and "Type" down here, and LabelStyle is looking one of them up - so the record is
            the only place either word is written.
          -->



          <!--
            ***** the labels *****

            Attribute names an ATTRIBUTE, not the text: one style, and every feature gets its own
            word. Style takes the VectorStyle so both arrive at the layer as one thing, because a
            layer takes a single style. Empty the Attribute pin and the fill passes through
            untouched - nothing named, nothing to write.
          -->
          <Pad Id="RZzJ7ARmOHcsPdJWcCLoP3" Comment="Label Attribute" Bounds="760,640,110,15" ShowValueBox="true" isIOBox="true" Value="Name">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">

            </p:TypeAnnotation>
          </Pad>
          <Pad Id="LKQjuhfaOhae1zpNGMpoU2" Comment="Label Size" Bounds="880,640,62,15" ShowValueBox="true" isIOBox="true" Value="16">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float32" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="520,590,130,19" Id="T23qWAurpyrgoRh8fLKCdS">
            <p:NodeReference LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="LabelStyle" />
            </p:NodeReference>
            <Pin Id="QNGu1JxjXlXVk8x5Vzah2L" Name="Style" Kind="InputPin" />
            <Pin Id="ULIbppmgrRmENEkrSodKrP" Name="Attribute" Kind="InputPin" />
            <Pin Id="MdXpohRLjhyLuWsCdwFoHx" Name="Color" Kind="InputPin" />
            <Pin Id="D4vCbMFhMY5ij6p7V7EUj9" Name="Size" Kind="InputPin" />
            <Pin Id="AzHYShl1Cy0Pdw52S7C5ZT" Name="Result" Kind="OutputPin" />
          </Node>



          <!--
            The style is a value of its own, and a node rather than pins on the layer. Leave it
            unconnected and the layer still draws something visible - good defaults are part of the
            public API.
          -->
          <!--
            ***** what a point looks like *****

            SymbolStyle is the style FOR POINTS - Mapsui's SymbolStyle derives from VectorStyle, so
            it takes its place in the chain rather than sitting next to it, and still feeds
            LabelStyle the same way.

            Without it a point is still drawn, but only as a RING: measured, the fallback marker
            covers 180 pixels where a filled one covers 952. Five times the ink, before anyone
            changes a colour.

            Scale 1 is 32 pixels - that is Mapsui's DefaultWidth, and Scale multiplies it. A symbol
            is drawn in PIXELS, so zoom the map and the markers stay the same size while the ground
            under them does not. Same split as a label.
          -->
          <Pad Id="EsoJaRP1I65f0rJfLdwzWW" Comment="Shape" Bounds="380,470,110,15" ShowValueBox="true" isIOBox="true" Value="Ellipse">
            <p:TypeAnnotation LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">

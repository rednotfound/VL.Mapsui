          <Pad Id="RYrJDbCHz1xvN0b3MHsmDc" Bounds="60,40,465,41" ShowValueBox="true" isIOBox="true" Value="Many features from one Record">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Ild2tR4nwZm5qRi2zto5HS" Bounds="60,95,600,82" ShowValueBox="true" isIOBox="true" Value="Define the type once; every place is an instance. Landmark is a Record (right-click the canvas: Record) with an ID, a Type and a Geometry. One ForEach makes Count of them; a second Splits each into a Feature: Geometry the shape, ID and Type its attributes.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="KY8NjWtra0yKn3qcR2yi4v" Bounds="624,284,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Turn Count up to 2000 and restart with F8, F5: two thousand places appear and not one node or link changes.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CPGmXC2LjtCeX6Qpg7jSlz" Bounds="624,828,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; The records are built once, in Create, and kept in the Landmarks pad. Rebuilding data every frame is what costs: 1000 features, 43 ms before anything is drawn.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="LB1DWoXpmlmXHsA2WMbnnk" Bounds="624,1263,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; SymbolStyle sizes points in PIXELS at every zoom (Scale 1 = 32). When size means something, buffer the point into a polygon and use VectorStyle.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />

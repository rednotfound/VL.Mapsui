          <Pad Id="BPpvXe8pgMsrjiIXVcfGVG" Comment="Left Pressed" Bounds="720,310,110,15" ShowValueBox="true" isIOBox="true" />

          <!--
            Click is what makes a press reach a widget, and it is a node rather than something the
            layer does behind your back. It takes a position and a gate exactly as Drag does, so
            the left button is a choice made here in the patch and not inside VL.Mapsui.

            Handled is why it is worth a node: without it a press on the zoom button would start a
            pan as well, and nothing on screen would say why. Left Pressed AND NOT Handled is the
            wiring that fixes that, and it is visible.
          -->
          <Node Bounds="60,460,110,19" Id="SSoldJI6PSmx31Lf6KGLS7">
            <p:NodeReference LastCategoryFullName="Mapsui.Widgets" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Click" />
            </p:NodeReference>
            <Pin Id="E4Breut4Ux4IRfeaOt11Qi" Name="Map" Kind="InputPin" />
            <Pin Id="Ik2jbiQW8wnjKKpSJ8vgF2" Name="Handled" Kind="OutputPin" />
            <Pin Id="HC78MB9PoxQ6O8bvEgW4Jv" Name="X" Kind="InputPin" />
            <Pin Id="AVOB1aXwJrDBGr5OEIzRv6" Name="Y" Kind="InputPin" />
            <Pin Id="H8P9lRDK2o8vc1i9csWdrV" Name="Pressed" Kind="InputPin" />
            <Pin Id="UMoXjGuYFCzzdNwOhlsOSz" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="Ig52cyIqtlUZUKVyyO59aE" Comment="Handled" Bounds="200,460,110,15" ShowValueBox="true" isIOBox="true" />

          <Node Bounds="340,410,37,19" Id="FCTlM02FYdKnpN0YX1hOrz">

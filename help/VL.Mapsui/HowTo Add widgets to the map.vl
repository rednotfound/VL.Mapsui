  <Patch Id="PxhKg8BscZY3FZ5BBq5V6S">
    <Canvas Id="GO0StuvySIilC684AxZCtY" DefaultCategory="Main" CanvasType="FullCategory" />
    <Node Name="Application" Bounds="100,100" Id="C7TpQCTkK0oo15gfZD0c0o">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <FullNameCategoryReference ID="Primitive" />
      </p:NodeReference>
      <Patch Id="KxpWAxhkSyww0ws29p3F9Z">
        <Canvas Id="HV5mZB2AHtDeSwYQHkHv8E" CanvasType="Group">

          <Pad Id="EskmCzlInzRJezMaD9KkUP" Bounds="60,30,660,190" ShowValueBox="true" isIOBox="true" Value="Widgets are Mapsui's own furniture: a scale bar, the attribution, buttons that zoom. Each node takes the map, puts one widget on it, and hands the map on - so they sit in a chain between Map and ToSkiaLayer.&#xD;&#xA;&#xD;&#xA;Map.Widgets is append only. Nothing can take a widget off a map again, which is why these are process nodes and why Enabled is how a widget goes away. The Widgets toggle drives all three; watch them appear and disappear without anything being rebuilt.&#xD;&#xA;&#xD;&#xA;Attribution reads its text from the layers on the map rather than from a pin. That is deliberate: OpenStreetMap's tile policy requires the attribution to be displayed, and a text you type in yourself can quietly stop matching the tiles on screen. The layer has carried that text since the beginning and nothing ever drew it until now.&#xD;&#xA;&#xD;&#xA;ZoomButtons needs clicks, and only the host can deliver those - a widget draws itself at a position only the renderer knows. So ToSkiaLayer offers a press to the widgets and keeps it only if one takes it. THE THING TO CHECK: click + and - and the map zooms, then drag somewhere away from the buttons and the map still pans. If a widget swallowed every press, dragging would break quietly.&#xD;&#xA;&#xD;&#xA;Turn Diagnostics on to see it: 'widgets N, M placed by the renderer' and 'last press X, Y taken by a widget / left for the patch'. A button that does nothing looks the same whether the click never arrived, arrived in the wrong units, or the widget had not been laid out yet - those two lines tell them apart.&#xD;&#xA;&#xD;&#xA;Enabled starts OFF, as everywhere in this package: opening a document in vvvv runs it.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>

          <Pad Id="EiFGTnBVhigsfbdwmQt39S" Comment="Enabled" Bounds="60,250,35,35" ShowValueBox="true" isIOBox="true" Value="false">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="ImmutableTypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:buttonmode p:Assembly="VL.UI.Forms" p:Type="VL.HDE.PatchEditor.Editors.ButtonModeEnum">Toggle</p:buttonmode>
            </p:ValueBoxSettings>
          </Pad>

          <!--
            Cache is left unconnected on purpose, and that is the whole of the cache story here:
            unconnected means the default folder under LOCALAPPDATA. Wiring a TileCache node is
            what HowTo Show a map is for.
          -->
          <Node Bounds="60,310,150,19" Id="KHnFw70ecMWVxZELXlyTl1">
            <p:NodeReference LastCategoryFullName="Mapsui.Layers" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />

          </Node>

          <!--
            Console is a LAYER, which is why its Output goes into the Group below rather than
            nowhere. Notifications travel through the Skia layer graph, so anything that wants the
            mouse has to sit in it - and that is the same road a press takes to reach a widget.
          -->
          <Node Bounds="500,250,90,19" Id="FCFHOaQxJF6hICTzgc0kV2">
            <p:NodeReference LastCategoryFullName="Graphics.Skia" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />

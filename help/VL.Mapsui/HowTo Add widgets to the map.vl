          <Pad Id="HiD7eSBvsW3FYJ9W54nAC8" Bounds="640,190,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; The mouse belongs to this window: MouseState is fed from Console, which is grouped with the map layer.">

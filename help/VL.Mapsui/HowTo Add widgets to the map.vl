            </p:NodeReference>
            <Pin Id="JLFcBHQpTCudwT4cR26v8a" Name="Enabled" Kind="InputPin" />
            <Pin Id="ALuFzsTrR4zRoYka0jm5xG" Name="Cache" Kind="InputPin" />
            <Pin Id="IZcuJT7w88rK5YvXc5hP0d" Name="Cache Status" Kind="OutputPin" />
            <Pin Id="Rzmk0zQoTlnL58F5IAtAIh" Name="Layers Built" Kind="OutputPin" />
            <Pin Id="IovYhVM0nvQMdLNOVUz0RX" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="LzEShfSKk61LhxMpR82M3a" Comment="Layers Built" Bounds="240,310,80,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="Shay0pkZOUlYXmQs0zZ7iS" Comment="Cache Status" Bounds="240,335,300,15" ShowValueBox="true" isIOBox="true" />


            <Pin Id="BvcvUEyhUH1r8leCQyYXZ3" Name="Input" Kind="StateInputPin" />
            <Pin Id="TwWMYrVSSDmAT3rNYtX8xR" Name="Output" Kind="StateOutputPin" />

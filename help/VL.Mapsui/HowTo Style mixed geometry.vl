          <!--
            ***** your own shapes, from here down *****

            The shape has to come from somewhere, and that somewhere is NOT VL.Mapsui: this package
            draws geometry, it does not create it. In a real patch the geometry comes from VL.NetTopologySuite,
            from a file, or from a service. Here it is a fixture so the example stands on its own.

            Read WKT is one way in and the shortest one to read on a page. VL.NetTopologySuite also
            builds geometry coordinate by coordinate - Coordinate, LinearRing, Polygon - and its own
            HowTo Create a polygon shows that. Either way what arrives here is the same type, which
            is the point: geometry is a TYPE, not a format.
          -->
          <Pad Id="H371JbTuI95SU88LiybnrC" Comment="a LINESTRING" Bounds="300,455,430,15" ShowValueBox="true" isIOBox="true" Value="LINESTRING (135.7490 34.9790, 135.7581 34.9859, 135.7680 34.9910)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="L1rVphP9dfdHdoZaRXO8tJ" Comment="a POINT" Bounds="300,480,430,15" ShowValueBox="true" isIOBox="true" Value="POINT (135.7581 34.9859)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="IrotR4gFylcZ62ydUXjBUC" Comment="a POLYGON" Bounds="300,430,430,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((135.7551 34.9834, 135.7611 34.9834, 135.7611 34.9884, 135.7551 34.9884, 135.7551 34.9834))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>

          <Node Bounds="300,470,90,19" Id="F5vfpYSEn6YZY4v3D0jivA">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />

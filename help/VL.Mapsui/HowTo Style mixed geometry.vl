            </p:NodeReference>
            <Pin Id="Hv9nORTiBeD0FjRJwQP1zt" Name="Input" Kind="InputPin" />
            <Pin Id="LVp2NShI38PM2uwngTMRoZ" Name="Input 2" Kind="InputPin" />
            <Pin Id="GhQqVC0IOJR94Fuop7tZb4" Name="Input 3" Kind="InputPin" />
            <Pin Id="PAwh0bTqOnKYu3GBgYxASP" Name="Result" Kind="OutputPin" />
          </Node>

          <!--
            ***** one style per geometry type *****

            A SymbolStyle draws POINTS AND NOTHING ELSE. Not a fainter polygon - none of it, zero
            pixels, no error anywhere. Measured: a polygon covers 14884 px under a VectorStyle,
            956 under NO STYLE AT ALL, and 0 under a SymbolStyle. Mapsui picks a renderer by the
            style's runtime type, and it does not help that SymbolStyle derives from VectorStyle.

            So a layer holding more than one kind of geometry needs StyleByGeometry, which hands
            each feature the style for ITS OWN kind. Every mapping library works this way:
            OpenLayers takes a style function returning styles[geometry.getType()], Mapbox GL
            splits circle / line / fill into separate layer types, Leaflet has pointToLayer beside
            style, a QGIS layer is single-geometry-type with its own renderer.

            DO NOT stack instead. Sending a VectorStyle and a SymbolStyle to one layer together
            does draw the polygon - and puts a SECOND circle on every point, because a VectorStyle
            draws its own 32 pixel marker there too. Measured: Scale 0.6 is 22 px across alone and
            34 px stacked, which is simply the default. Dispatch, do not stack.
          -->
          <Pad Id="EsoJaRP1I65f0rJfLdwzWW" Comment="Shape" Bounds="520,420,110,15" ShowValueBox="true" isIOBox="true" Value="Ellipse">
            <p:TypeAnnotation LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">
              <Choice Kind="TypeFlag" Name="SymbolShape" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="E2tJMBZkwB64ZplxWXqbUf" Comment="Scale - 1 is 32 pixels" Bounds="520,445,150,15" ShowValueBox="true" isIOBox="true" Value="0.8">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float32" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="700,420,130,19" Id="T4PA3iOraHVrJGn6DvQeiR">
            <p:NodeReference LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="SymbolStyle" />
            </p:NodeReference>
            <Pin Id="TyQdZgTtemihQDtdTArRzO" Name="Shape" Kind="InputPin" />
            <Pin Id="Hi8HbKmtdTSgvaR4xUm0gZ" Name="Scale" Kind="InputPin" />
            <Pin Id="RCFOdPirbEB8H7XNNlycYR" Name="Fill Color" Kind="InputPin" />
            <Pin Id="C5ZflBD4w9puJqzqVcE4hc" Name="Outline Color" Kind="InputPin" />
            <Pin Id="VMyWIw2DDLYJnnMn4lhUAv" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="700,490,130,19" Id="OoOGIwa84AzTM5XuXsnNNd">
            <p:NodeReference LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="VectorStyle" />
            </p:NodeReference>
            <Pin Id="NWFqDIKalaxaGQVLqfQHBi" Name="Fill Color" Kind="InputPin" />
            <Pin Id="F00RpgC9bhD9HuhOAUsoNX" Name="Line Color" Kind="InputPin" />
            <Pin Id="UumeV5rj8Ly2LZmKZzyjuo" Name="Line Width" Kind="InputPin" />
            <Pin Id="L1aoACb3f4LbGARGqmQ62T" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="880,455,150,19" Id="BGaqvRC4MElrp0JTGZqZS6">
            <p:NodeReference LastCategoryFullName="Mapsui.Styles" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="StyleByGeometry" />
            </p:NodeReference>
            <Pin Id="I6WyRuzI4KKr7dc1hjwvN7" Name="Point" Kind="InputPin" />
            <Pin Id="O1w6N9lFrBJJ5hf2DOGjEq" Name="Line" Kind="InputPin" />
            <Pin Id="GX5IGC2zL2N3MZ96i7FQH7" Name="Polygon" Kind="InputPin" />
            <Pin Id="K8NLNKRTcQvzNPLxdPvIgz" Name="Result" Kind="OutputPin" />
          </Node>

          <Node Bounds="300,590,150,19" Id="RYg4JjkLhluvFy6irExfYD">
            <p:NodeReference LastCategoryFullName="Mapsui.Layers" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="FeatureLayer" />
            </p:NodeReference>
            <Pin Id="AMeaHKeDjwSfsDqswpSIBi" Name="Features" Kind="InputPin" />
            <Pin Id="Sb8LY47ypOqKRxpyRAwgiA" Name="Style" Kind="InputPin" />
            <Pin Id="U7vVs30TfyVg6lNRtRKCvd" Name="Name" Kind="InputPin" />
            <Pin Id="UX2Q4zuDSJ3FicIQjybU4g" Name="Layers Built" Kind="OutputPin" />
            <Pin Id="JmLEV1bgiJBumZ68I8Jh1k" Name="Status" Kind="OutputPin" />
            <Pin Id="Ck0b9Fm6W6GxEbNGJgeI05" Name="Result" Kind="OutputPin" />
          </Node>

          <Node Bounds="87,643,110,19" Id="Uap6qMPmqPyqpm6OmKwWZU">
            <p:NodeReference LastCategoryFullName="Mapsui.Maps" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="Map" />
            </p:NodeReference>
            <Pin Id="H1dkptL5CUJAlSE1SJXIiL" Name="Layers" Kind="InputPin" />
            <Pin Id="Dc7rTes8gEFct080wrJNsg" Name="Initial Center Longitude" Kind="InputPin" />
            <Pin Id="LpWIQOKhRMT4Jt3tKQLG58" Name="Initial Center Latitude" Kind="InputPin" />
            <Pin Id="JXjk0f1EzodWnmeV9gOzZp" Name="Initial Zoom Level" Kind="InputPin" />
            <Pin Id="SHAzWUqXFUmNiPpi2L0l9h" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="-207,850,110,19" Id="BtM6e71LrPauAI1Lu5QMUn">
            <p:NodeReference LastCategoryFullName="Mapsui" LastDependency="VL.Mapsui.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="ViewportInfo" />
            </p:NodeReference>
            <Pin Id="TIjKhLd4rTZDn2dSnszv01" Name="Map" Kind="InputPin" />
            <Pin Id="RkfLJEI1nD6Jqo2WEFBeYS" Name="Center Longitude" Kind="OutputPin" />
            <Pin Id="UUT74iRejEUw8kpEAa6dHx" Name="Center Latitude" Kind="OutputPin" />
            <Pin Id="NHrVzYogipFEDxC3IV2qWZ" Name="Resolution" Kind="OutputPin" />
            <Pin Id="NIsTrVwZSBOI2ZxVDBGylo" Name="Width" Kind="OutputPin" />
            <Pin Id="Ai21lXxwGlrZ63Z4TigeFN" Name="Height" Kind="OutputPin" />
          </Node>
          <Pad Id="FFjk3xX3QUXJDZcekXlKZa" Comment="Actual Longitude" Bounds="-205,898,90,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="IhsKJMIfZsfYF6xUlVucLc" Comment="Actual Latitude" Bounds="-205,927,90,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="C3LbWfwVElJKvc3TxkWobj" Comment="m per pixel" Bounds="-205,958,90,15" ShowValueBox="true" isIOBox="true" />
          <!--
            ***** enough mouse to see the point *****

            Drag and ZoomByWheel are gestures, not per-frame commands: they move the map only when
            you actually drag or scroll, so the view stays yours. That is what lets this patch show
            the one thing it is about - the shape staying on its ground while the map moves under
            it. The wiring is copied from HowTo Drive the map with the mouse, which is where the
            reasoning behind each link lives.
          -->
          <Node Bounds="480,700,90,19" Id="FCFHOaQxJF6hICTzgc0kV2">
            <p:NodeReference LastCategoryFullName="Graphics.Skia" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />

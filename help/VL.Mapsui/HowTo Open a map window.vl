            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Nb7gwZRj59pK2AWurF7dwF" Bounds="60,90,560,64" ShowValueBox="true" isIOBox="true" Value="A map in one node. Connect layers and the window answers the mouse: left drag pans, the wheel zooms. This patch ships with Enabled off - switch it on to fetch OpenStreetMap.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>

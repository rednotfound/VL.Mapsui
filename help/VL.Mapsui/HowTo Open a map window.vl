          <Pad Id="RBizgUTcj8NQBJXfEerLQS" Bounds="60,40,240,41" ShowValueBox="true" isIOBox="true" Value="Use MapWindow!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
